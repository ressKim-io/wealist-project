		{
			"name": "4. Saved Views",
			"item": [
				{
					"name": "Create View",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"VIEW_ID\", jsonData.view_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"project_id\": \"{{PROJECT_ID}}\",\n    \"name\": \"High Priority Tasks\",\n    \"description\": \"View for high priority tasks\",\n    \"is_shared\": true,\n    \"filters\": {\n        \"{{FIELD_ID}}\": {\n            \"operator\": \"eq\",\n            \"value\": \"{{OPTION_ID}}\"\n        }\n    },\n    \"sort_by\": \"created_at\",\n    \"sort_direction\": \"desc\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/views",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "views"]
						}
					},
					"response": []
				},
