							"host": ["{{BASE_URL}}"],
							"path": ["api", "projects", "{{PROJECT_ID}}", "views"]
						}
					},
					"response": []
				},
				{
					"name": "Update View",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated View Name\",\n    \"description\": \"Updated description\",\n    \"is_shared\": false\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/views/{{VIEW_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "views", "{{VIEW_ID}}"]
						}
					},
					"response": []
				},
				{
					"name": "Delete View",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/views/{{VIEW_ID}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "views", "{{VIEW_ID}}"]
						}
					},
					"response": []
				},
				{
					"name": "Apply View (Get Filtered Boards)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/views/{{VIEW_ID}}/boards?page=1&limit=20",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "views", "{{VIEW_ID}}", "boards"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						},
						"description": "Apply view filters and get boards"
					},
					"response": []
				},
				{
					"name": "Update Board Order in View",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"view_id\": \"{{VIEW_ID}}\",\n    \"board_orders\": [\n        {\n            \"board_id\": \"{{BOARD_ID}}\",\n            \"display_order\": 0\n        }\n    ]\n}"
						},
						"url": {
